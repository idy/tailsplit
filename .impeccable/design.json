  "narrative": {
    "northStar": "The Desktop Configuration Panel",
    "overview": "TailSplit uses a compact, neutral desktop configuration panel with system typography, blue actions, and semantic connection states. This system applies to the embedded configuration UI in macOS WKWebView and Windows WebView2. It preserves the incumbent desktop world selected by the user.\n\nSystem appearance changes the surfaces, text, borders, and state treatments through CSS media queries. Density supports repeated local configuration tasks; clear labels, separate draft states, and explicit actions carry the hierarchy.",
    "keyCharacteristics": [
      "Neutral surfaces that follow system appearance.",
      "Compact controls with visible keyboard focus.",
      "Text-backed semantic state colors.",
      "Native window chrome and practical configuration density."
    ],
    "rules": [
      {
        "name": "The Appearance Rule",
        "body": "Use the existing semantic CSS properties so light and dark appearance change together. The accent fill remains shared; accent text and hover colors adapt.",
        "section": "colors"
      },
      {
        "name": "The State Rule",
        "body": "Pair semantic color with a readable state label; selected, pending, current, connected, warning, and error are distinct.",
        "section": "colors"
      },
      {
        "name": "The Desktop Type Rule",
        "body": "Use the incumbent system text stack for interface text and the mono stack for configuration and diagnostic content.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal surfaces and hairline separators for ordinary panels; reserve ambient shadows for overlays and the small switch thumb.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic CSS properties for both system appearances.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do allow English and Chinese labels, long addresses, and helper text to wrap where the source provides for it.",
      "Do keep current and pending selections visibly distinct and provide explicit confirmation."
    ],
    "donts": [
      "Don't apply this desktop panel system to the public website without inspecting that surface's own implementation.",
      "Don't replace the chosen neutral desktop world with a new visual identity or illustration.",
      "Don't imply a connection or saved configuration from selection styling alone."
    ]
  }
