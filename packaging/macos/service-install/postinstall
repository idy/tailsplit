#!/bin/sh
set -eu
umask 077

owner_uid=$(/usr/bin/stat -f %u /dev/console)
owner_gid=$(/usr/bin/stat -f %g /dev/console)
case "$owner_uid:$owner_gid" in
  *[!0-9:]*|0:*|:*)
    echo "Log in to the desktop before installing TailSplit." >&2
    exit 1
    ;;
esac
if [ "$owner_uid" -lt 500 ]; then
  echo "TailSplit needs a logged-in desktop user." >&2
  exit 1
fi

support="/Library/Application Support/TailSplit"
helper="/Library/PrivilegedHelperTools/im.lbv.tailsplit.helper"
plist="/Library/LaunchDaemons/im.lbv.tailsplit.helper.plist"
/bin/mkdir -p "$support"
/usr/sbin/chown root:wheel "$support" "$helper"
/bin/chmod 700 "$support"
/bin/chmod 755 "$helper"

cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>im.lbv.tailsplit.helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/im.lbv.tailsplit.helper</string>
    <string>service</string><string>--uid</string><string>$owner_uid</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array><string>im.lbv.tailsplit</string></array>
  <key>ProcessType</key><string>Interactive</string>
  <key>ExitTimeOut</key><integer>25</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/Library/Application Support/TailSplit/service.log</string>
  <key>Sockets</key>
  <dict>
    <key>Control</key>
    <dict>
      <key>SockFamily</key><string>Unix</string>
      <key>SockType</key><string>stream</string>
      <key>SockPathName</key><string>/var/run/im.lbv.tailsplit.sock</string>
      <key>SockPathOwner</key><integer>$owner_uid</integer>
      <key>SockPathGroup</key><integer>$owner_gid</integer>
      <key>SockPathMode</key><integer>384</integer>
    </dict>
  </dict>
</dict>
</plist>
PLIST
/usr/sbin/chown root:wheel "$plist"
/bin/chmod 644 "$plist"
/usr/bin/touch "$support/service.log"
/bin/chmod 600 "$support/service.log"
/usr/bin/plutil -lint "$plist"
/bin/launchctl enable system/im.lbv.tailsplit.helper

# Registration can transiently fail while launchd finishes an earlier removal.
# A bounded retry also covers an upgrade from a package without the preinstall
# shutdown wait. Never report an installed service unless its job is registered.
attempt=0
until /bin/launchctl bootstrap system "$plist"; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 5 ]; then
    echo "TailSplit's network service could not be registered with launchd." >&2
    exit 1
  fi
  /bin/sleep 1
done
/bin/launchctl print system/im.lbv.tailsplit.helper >/dev/null
