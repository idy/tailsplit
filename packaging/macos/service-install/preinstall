#!/bin/sh
set -eu

if [ "${3:-/}" != "/" ]; then
  echo "TailSplit must install on the running macOS system." >&2
  exit 1
fi

support="/Library/Application Support/TailSplit"
if [ -L "$support" ]; then
  echo "TailSplit's service directory must not be a symbolic link." >&2
  exit 1
fi
if [ -e "$support" ] && [ "$(/usr/bin/stat -f %u "$support")" != 0 ]; then
  echo "TailSplit's service directory must be owned by root." >&2
  exit 1
fi
if [ -e "$support" ]; then
  support_mode=$(/usr/bin/stat -f %Lp "$support")
  if [ $((0$support_mode & 022)) -ne 0 ]; then
    echo "TailSplit's service directory must not be writable by other users." >&2
    exit 1
  fi
fi

# Stop the old service before Installer replaces its running executable.
# launchd delivers SIGTERM; the service closes its engine, DNS and routes.
if /bin/launchctl print system/im.lbv.tailsplit.helper >/dev/null 2>&1; then
  /bin/launchctl bootout system/im.lbv.tailsplit.helper
fi

# bootout returns before launchd finishes removing an active job. Do not let
# Installer replace mapped code, or let postinstall bootstrap the same label,
# until the old process has finished its DNS/route cleanup and left launchd.
attempt=0
while /bin/launchctl print system/im.lbv.tailsplit.helper >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 35 ]; then
    echo "TailSplit's previous service did not finish stopping; its executable has not been replaced." >&2
    exit 1
  fi
  /bin/sleep 1
done
