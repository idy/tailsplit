<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+ can transfer app data despite allowBackup=false. Exclude every
         backup domain from both transports to keep device identity on this device.
         AppPaths stores exit.json, settings.json, tailscale/ and cache.db in filesDir
         (the file domain); root does not cover the other domains. The native core's
         noBackupFilesDir and cacheDir are already excluded by Android. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
